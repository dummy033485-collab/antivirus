<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SafeShield" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/shield_background</item>
    </style>

    <style name="Theme.SafeShield.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/shield_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_shield</item>
        <item name="postSplashScreenTheme">@style/Theme.SafeShield</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>
</resources>
